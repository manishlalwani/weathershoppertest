<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Weather Shopper Test Suite" parallel="tests" thread-count="1" verbose="2">
  <test name="End to End Test - Chrome">
    <parameter name="browser" value="chrome"/>
    <classes>
      <class name="com.weathershopper.tests.testcases.HomePageTestCases"/>
    </classes>
  </test>
  <test name="End to End Test - Firefox">
    <parameter name="browser" value="firefox"/>
    <classes>
      <class name="com.weathershopper.tests.testcases.HomePageTestCases"/>
    </classes>
  </test>
</suite>
