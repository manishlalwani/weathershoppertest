<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Weather Shopper Test Suite" parallel="tests" thread-count="4" verbose="3">
  <test name="End to End Test to Select Products Based on Current Temperature - Chrome">
     <parameter name="browser" value="chrome"/>
     <classes>
       <class name="com.flinktests.testcases.homepagetestcases"/>
    </classes>
  </test>
  <test name="End to End Test to Select Products Based on Current Temperature - Firefox">
     <parameter name="browser" value="firefox"/>
     <classes>
       <class name="com.flinktests.testcases.homepagetestcases"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->
